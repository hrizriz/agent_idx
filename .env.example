# Path to daily_stock_summary_*.parquet files
PARQUET_DIR=D:\MLOps - Project\stock_idx\airflow\data\parquet
# PDF/CSV exports
EXPORT_DIR=D:\personal_project\agent_idx\exports
# Learning knowledge base
KNOWLEDGE_DIR=D:\personal_project\agent_idx\knowledge
CHAT_DB_PATH=D:\personal_project\agent_idx\data\telegram_chat.db

# Cron (runs inside `py -3 main.py bot`)
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Jakarta
CRON_MARKET=45 16 * * 1-5
CRON_NEWS=15 17 * * 1-5
CRON_WEEKLY=0 9 * * 0

# gemini-web2api (OpenAI-compatible)
LLM_BASE_URL=http://localhost:18765/v1
LLM_API_KEY=sk-local
LLM_MODEL=gemini-3.5-flash-thinking

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Interaction group only (bot replies here). Supports CHAT_ID alias.
# Other groups: bot silently collects chat for search_chat_history.
TELEGRAM_CHAT_ID=

# Agent limits
MAX_SQL_ROWS=100
MAX_AGENT_STEPS=8
