# Path to daily_stock_summary_*.parquet files
PARQUET_DIR=C:\Users\Datalabs\Pictures\agent_idx\data\parquet
# stockbit (default) | yahoo | all â€” prefer Chartbit farm panel over Yahoo
MARKET_SOURCE=stockbit
# PDF/CSV exports
EXPORT_DIR=D:\personal_project\agent_idx\exports
# Learning knowledge base
KNOWLEDGE_DIR=D:\personal_project\agent_idx\knowledge
CHAT_DB_PATH=D:\personal_project\agent_idx\data\telegram_chat.db
CHROMA_DIR=D:\personal_project\agent_idx\data\chroma

# Cron (runs inside `py -3 main.py bot`)
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Jakarta
CRON_MARKET=45 16 * * mon-fri
# Stockbit stream farm weekdays 16:50 â€” @StockbitReports + https://stockbit.com/Stockbit
CRON_REPORTS=50 16 * * mon-fri
CRON_REPORTS_DAYS=3
# Chartbit farm weekdays 17:00 WIB â€” https://stockbit.com/symbol/{TICKER}/chartbit
CRON_FARM=0 17 * * mon-fri
CRON_FARM_TIMEFRAMES=1H,1D
CRON_FARM_SYNC_DAILY=true
# Financials + Key Stats + Profile. Seluruh universe makan ~26 jam, jadi dipecah:
# Jumat 07:00 emiten papan atas, Sabtu 07:00 sisanya.
CRON_FUNDAMENTALS=0 7 * * fri
CRON_FUNDAMENTALS_REST=0 7 * * sat
FUNDAMENTALS_TOP_N=200
CRON_NEWS=15 17 * * mon-fri
CRON_WEEKLY=0 9 * * sun

# gemini-web2api (OpenAI-compatible)
LLM_BASE_URL=http://localhost:18765/v1
LLM_API_KEY=sk-local
LLM_MODEL=gemini-3.6-flash-thinking

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Interaction group only (bot replies here). Supports CHAT_ID alias.
# Other groups: bot silently collects chat for search_chat_history.
TELEGRAM_CHAT_ID=

# Agent limits
MAX_SQL_ROWS=100

# Stockbit browser â€” share login cookies with farm script
# Use false if Chartbit blank / captcha / OTP UI flaky in headless
STOCKBIT_HEADLESS=false
STOCKBIT_PROFILE_DIR=C:\Users\Datalabs\Pictures\agent_idx\data\stockbit_profile
# DuckDB OHLCV store for structured chart query tools
CHART_DB_PATH=C:\Users\Datalabs\Pictures\agent_idx\data\charts.duckdb
# DuckDB user documents (confirmation-gated ingest)
DOC_DB_PATH=C:\Users\Datalabs\Pictures\agent_idx\data\documents.duckdb
